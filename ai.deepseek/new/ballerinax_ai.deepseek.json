              "description": "Tool definitions to be used for the tool call",
              "type": {
                "name": "ChatCompletionFunctions[]",
                "links": [
                  {
                    "category": "external",
                    "recordName": "ChatCompletionFunctions",
                    "libraryName": "ballerina/ai"
                  }
                ]
              }
            },
            {
              "name": "stop",
              "description": "Stop sequence to stop the completion",
              "type": {
                "name": "string|()"
              },
              "optional": true,
              "default": "()"
            }
          ],
          "return": {
            "description": "Function to be called, chat response or an error in-case of failures",
            "type": {
              "name": "ChatAssistantMessage|Error",
              "links": [
