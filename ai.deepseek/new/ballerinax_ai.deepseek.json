          "name": "chat",
          "type": "Remote Function",
          "description": "Generates a chat completion message from a Deepseek model\n",
          "parameters": [
            {
              "name": "messages",
              "description": "List of chat messages or a user message",
              "type": {
                "name": "ChatMessage[]|ChatUserMessage",
                "links": [
