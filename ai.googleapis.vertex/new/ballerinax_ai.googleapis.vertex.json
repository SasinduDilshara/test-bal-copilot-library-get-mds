        {
          "name": "embed",
          "type": "Remote Function",
          "description": "Converts the given chunk into a vector embedding.\n",
          "parameters": [
            {
              "name": "chunk",
              "description": "The chunk to convert into an embedding (only `ai:TextChunk` and `ai:TextDocument` are supported)",
              "type": {
                "name": "Chunk",
                "links": [
                  {
                    "category": "external",
                    "recordName": "Chunk",
                    "libraryName": "ballerina/ai"
                  }
                ]
              }
            }
          ],
          "return": {
            "description": "The embedding vector representation on success; `ai:LlmConnectionError` if the HTTP call\nfails; `ai:LlmInvalidResponseError` if the model returns no embeddings;\n`ai:Error` if the chunk type is not supported",
            "type": {
              "name": "Vector|SparseVector|HybridVector|Error",
              "links": [
                {
                  "category": "external",
                  "recordName": "Vector",
                  "libraryName": "ballerina/ai"
                },
                {
                  "category": "external",
                  "recordName": "SparseVector",
                  "libraryName": "ballerina/ai"
                },
                {
                  "category": "external",
                  "recordName": "HybridVector",
                  "libraryName": "ballerina/ai"
                },
                {
                  "category": "external",
                  "recordName": "Error",
                  "libraryName": "ballerina/ai"
                }
              ]
            }
          }
        },
        {
          "name": "batchEmbed",
          "type": "Remote Function",
          "description": "Converts a batch of chunks into vector embeddings by calling the embed endpoint for each chunk.\nChunks are processed sequentially. On the first failure, processing halts and no partial\nresults are returned. Vertex AI does not expose a native batch embedding endpoint for\nGemini models, so each chunk requires its own HTTP round trip.\n",
          "parameters": [
            {
              "name": "chunks",
              "description": "The chunks to convert into embeddings (only `ai:TextChunk` and `ai:TextDocument` are supported)",
              "type": {
